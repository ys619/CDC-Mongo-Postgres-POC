# ==============================================================================
# CDC POC Configuration: MongoDB -> Kafka (Debezium) -> PostgreSQL
# ==============================================================================

# Isolated MongoDB Source (Docker container)
MONGO_HOST_PORT=27018
MONGO_REPLICA_SET=rs0
MONGO_SOURCE_DB=ISRA_new

# Apache Kafka (KRaft mode)
KAFKA_HOST_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Debezium / Kafka Connect
CONNECT_HOST_PORT=8083

# Kafka UI
KAFKA_UI_HOST_PORT=8082

# PostgreSQL Target
POSTGRES_HOST_PORT=5432
POSTGRES_DB=isra_cdc
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# CDC Consumer
CONSUMER_GROUP_ID=isra-cdc-consumer-group
TOPIC_PATTERN=^mongo_cdc\.(ISRA|ISRA_new)\..*
LOG_LEVEL=INFO
